load("@mercury_config//:defs.bzl", "COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "editor_lib",
    srcs = [
        "console.cc",
        "console_panel.cc",
        "dialogs.cc",
        "editor_app.cc",
        "editor_frame.cc",
        "editor_icons.cc",
        "editor_scene.cc",
        "editor_settings.cc",
        "hierarchy_panel.cc",
        "input_actions_panel.cc",
        "input_actions_window.cc",
        "inspector_panel.cc",
        "launcher_frame.cc",
        "lore_panel.cc",
        "lore_vcs.cc",
        "play_session.cc",
        "project_browser_panel.cc",
        "release_build.cc",
        "scene_view.cc",
        "scene_viewport_panel.cc",
        "script_language.cc",
        "script_parser.cc",
        "script_vim.cc",
        "script_editor_panel.cc",
        "script_editor_tab.cc",
        "templates.cc",
        "ui_builder.cc",
        "ui_builder_panel.cc",
        "wx_theme.cc",
    ],
    hdrs = glob(["*.h"]),
    copts = COPTS,
    includes = ["."],
    deps = [
        "//mercury:mercury",
        "@wxwidgets//:wxwidgets",
    ],
)

cc_binary(
    name = "mercury_editor",
    srcs = ["main.cc"],
    copts = COPTS,
    # Play and Build run the game through mercury_player, which the editor finds next to itself
    # (PlaySession::PlayerPath), so building the editor builds the player too.
    data = [
        "//mercury:mercury_player",
        "//mercury/shaders:shaders",
    ],
    deps = [":editor_lib"],
)
