module(
    name = "mercury",
    version = "0.0.0",
)

# AngelScript is a plain C++ library built by //third_party/angelscript. It is
# the only scripting dependency; there is no code generation, Python toolchain
# or external build system involved.

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")

# Xcode 26's clang writes SDKSettings.json into every .d file; Bazel's header
# discovery rejects that absolute path. Strip it in the toolchain wrapper.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = ["//third_party/patches:rules_cc_xcode26.patch"],
)

# --------------------------------------------------------------------------
# Third-party dependencies keep their own build systems. These repositories
# expose the existing submodule checkouts, and rules_foreign_cc runs their
# CMake builds (see third_party/BUILD.bazel).
# --------------------------------------------------------------------------

local_source_repo = use_repo_rule("//third_party:repositories.bzl", "local_source_repo")

local_source_repo(name = "glfw_src", path = "third_party/glfw")
local_source_repo(name = "assimp_src", path = "third_party/assimp")
local_source_repo(name = "jolt_src", path = "third_party/JoltPhysics")
local_source_repo(name = "yoga_src", path = "third_party/yoga")
local_source_repo(name = "tinyxml2_src", path = "third_party/tinyxml2")
local_source_repo(name = "meshoptimizer_src", path = "third_party/meshoptimizer")
local_source_repo(name = "miniaudio_src", path = "third_party/miniaudio")

yoga_wrapper_repo = use_repo_rule("//third_party:repositories.bzl", "yoga_wrapper_repo")

yoga_wrapper_repo(name = "yoga_wrapper")

vulkan_repo = use_repo_rule("//third_party:repositories.bzl", "vulkan_repo")

vulkan_repo(name = "vulkan")

dxc_repo = use_repo_rule("//third_party:repositories.bzl", "dxc_repo")

dxc_repo(name = "dxc")

build_config_repo = use_repo_rule("//third_party:repositories.bzl", "build_config_repo")

build_config_repo(name = "mercury_config")
