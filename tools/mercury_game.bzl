"""Builds a Mercury project whose gameplay is C++ (MERCURY_SCRIPT).

    load("//tools:mercury_game.bzl", "mercury_game")

    mercury_game(
        name = "my_game",
        project = "my_game.mproj",
    )

Every .cc/.cpp under the package's scripts/ folder (recursively) is compiled
into the game executable together with the engine. A generated main() opens
the project at `<package>/<project>` when no project argument is given, so
`bazelisk run //path/to/game` works from the workspace root.

A project can also keep AngelScript `.as` files: they are compiled by the
player at run time. The C++ and AngelScript classes share the same map
component names and reflection schema.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")

_DEFINES = [
    "MERCURY_GRAPHICS_VULKAN=1",
    "GLFW_INCLUDE_VULKAN=1",
    "GLM_FORCE_DEPTH_ZERO_TO_ONE=1",
]

def mercury_game(name, project, scripts = None, srcs = [], deps = [],
                 copts = [], visibility = None, **kwargs):
    """Defines a cc_binary that runs a Mercury project with C++ scripts.

    Args:
        name: The executable target name.
        project: The .mproj file name, relative to this BUILD package.
        scripts: C++ script sources. Defaults to every .cc/.cpp under scripts/.
        srcs: Extra C++ sources (labels or package-relative files).
        deps: Extra cc_library dependencies.
        copts: Extra compiler options.
        visibility: Standard Bazel visibility.
        **kwargs: Passed to cc_binary.
    """
    if scripts == None:
        scripts = native.glob([
            "scripts/**/*.cc",
            "scripts/**/*.cpp",
            "scripts/**/*.h",
            "scripts/**/*.hpp",
        ], allow_empty = True)

    package = native.package_name()
    project_path = (package + "/" if package else "") + project

    write_file(
        name = name + "_main",
        out = name + "_main.cc",
        content = [
            "// Generated by mercury_game; do not edit.",
            "#include \"player/player.h\"",
            "",
            "int main(int argc, char** argv) {",
            "  return Mercury::RunPlayer(argc, argv, \"%s\");" % project_path,
            "}",
        ],
    )

    native.cc_binary(
        name = name,
        srcs = [":" + name + "_main"] + scripts + srcs,
        deps = ["//mercury:mercury"] + deps,
        includes = ["scripts"],
        defines = _DEFINES,
        data = [
            project,
            "//mercury/shaders:shaders",
        ],
        copts = copts,
        visibility = visibility,
        **kwargs
    )
