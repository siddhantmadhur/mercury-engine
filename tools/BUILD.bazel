load("@mercury_config//:defs.bzl", "COPTS")

package(default_visibility = ["//visibility:public"])

# Compiler launcher for the rules_foreign_cc dependency builds. It enables
# ccache when available and otherwise passes through to the compiler; see the
# script for why it must clear CCACHE_DISABLE.
filegroup(
    name = "ccache_wrapper",
    srcs = ["ccache_wrapper.sh"],
)

# The matc material compiler Filament's CMake build installs. The cmake rule
# exposes it as the "matc" output group; wrap it so it can be used as an
# executable tool. //tools:matc is consumed in the target configuration (see
# matc.bzl), so it reuses the Filament libraries Mercury already links instead
# of triggering a host-config Filament build.
filegroup(
    name = "matc_out",
    output_group = "matc",
    srcs = ["//third_party:filament_build"],
)

genrule(
    name = "matc",
    executable = True,
    outs = ["matc.sh"],
    srcs = [":matc_out"],
    cmd = "cp $(execpath :matc_out) $@ && chmod +x $@",
)

cc_binary(
    name = "model_info",
    srcs = ["model_info.cc"],
    copts = COPTS,
    deps = ["//mercury:mercury"],
)
