{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "ESNext.Decorators"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": { "mercury": ["./.mercury/types/mercury/index.ts"] }
  },
  "include": ["scripts/**/*.ts", ".mercury/types/**/*.ts"]
}
