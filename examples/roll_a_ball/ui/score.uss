.score-box {
    position: absolute;
    left: 16px;
    top: 70px;
    padding: 8px 12px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.45);
}

.score {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
}

.help {
    color: rgba(255, 255, 255, 0.6);
}

.win {
    position: absolute;
    left: 0;
    right: 0;
    top: 35%;
    -unity-text-align: middle-center;
    font-size: 64px;
    -unity-font-style: bold;
    color: #FFD84D;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #3A2600;
    transition: opacity 0.4s ease-out, scale 0.5s ease-out-back;
}

.win--hidden {
    opacity: 0;
    scale: 0.5 0.5;
}
