[mmap]
format = 2
editor_version = "1.0.0"

[[component]]
node = "."
type = "Transform"

[[component]]
node = "."
type = "PongGame"
[component.props]
ball = { path = "Ball" }

[[component]]
node = "."
type = "UIDocument"
[component.props]
source_asset = { ext = "1" }

[[component]]
node = "Camera"
type = "Transform"

[[component]]
node = "Camera"
type = "Camera"
[component.props]
fit_height = 90.0

[[component]]
node = "Player"
type = "Transform"
[component.props]
position = { vec3 = [-68.0, 0.0, 0.0] }
scale = { vec3 = [2.0, 10.0, 1.0] }

[[component]]
node = "Player"
type = "SpriteRenderer"
[component.props]
material = { ext = "2" }

[[component]]
node = "Player"
type = "Rigidbody"
[component.props]
allow_sleeping = false
allowed_dofs = "translation_y"
angular_damping = 0.0
gravity_factor = 0.0
linear_damping = 0.0
motion_quality = "linear_cast"
motion_type = "kinematic"

[[component]]
node = "Player"
type = "BoxCollider"
[component.props]
material = { ext = "3" }
size = { vec3 = [1.0, 1.0, 10.0] }

[[component]]
node = "Player"
type = "Paddle"
[component.props]
limit = 40.0

[[component]]
node = "Player"
type = "PlayerController"
[component.props]
downKey = "S"
speed = 70.0
upKey = "W"

[[component]]
node = "Enemy"
type = "Transform"
[component.props]
position = { vec3 = [68.0, 0.0, 0.0] }
scale = { vec3 = [2.0, 10.0, 1.0] }

[[component]]
node = "Enemy"
type = "SpriteRenderer"
[component.props]
material = { ext = "2" }

[[component]]
node = "Enemy"
type = "Rigidbody"
[component.props]
allow_sleeping = false
allowed_dofs = "translation_y"
angular_damping = 0.0
gravity_factor = 0.0
linear_damping = 0.0
motion_quality = "linear_cast"
motion_type = "kinematic"

[[component]]
node = "Enemy"
type = "BoxCollider"
[component.props]
material = { ext = "3" }
size = { vec3 = [1.0, 1.0, 10.0] }

[[component]]
node = "Enemy"
type = "Paddle"
[component.props]
limit = 40.0

[[component]]
node = "Enemy"
type = "EnemyAI"
[component.props]
ball = { path = "Ball" }
gain = 8.0
speed = 45.0

[[component]]
node = "Ball"
type = "Transform"
[component.props]
scale = { vec3 = [2.0, 2.0, 1.0] }

[[component]]
node = "Ball"
type = "SpriteRenderer"
[component.props]
material = { ext = "2" }

[[component]]
node = "Ball"
type = "Rigidbody"
[component.props]
allow_sleeping = false
allowed_dofs = "translation_xy"
angular_damping = 0.0
gravity_factor = 0.0
linear_damping = 0.0
motion_quality = "linear_cast"
motion_type = "dynamic"

[[component]]
node = "Ball"
type = "BoxCollider"
[component.props]
material = { ext = "4" }
size = { vec3 = [1.0, 1.0, 10.0] }

[[component]]
node = "Ball"
type = "Ball"
[component.props]
minHorizontal = 0.45
serveAngle = 35.0
speed = 60.0

[[component]]
node = "Walls"
type = "Transform"

[[component]]
node = "Walls/Top"
type = "Transform"
[component.props]
position = { vec3 = [0.0, 45.0, 0.0] }

[[component]]
node = "Walls/Top"
type = "PlaneCollider"
[component.props]
normal = { vec3 = [0.0, -1.0, 0.0] }

[[component]]
node = "Walls/Bottom"
type = "Transform"
[component.props]
position = { vec3 = [0.0, -45.0, 0.0] }

[[component]]
node = "Walls/Bottom"
type = "PlaneCollider"
[component.props]
normal = { vec3 = [0.0, 1.0, 0.0] }

[[component]]
node = "Walls/Left"
type = "Transform"
[component.props]
position = { vec3 = [-80.0, 0.0, 0.0] }

[[component]]
node = "Walls/Left"
type = "PlaneCollider"
[component.props]
normal = { vec3 = [1.0, 0.0, 0.0] }

[[component]]
node = "Walls/Left"
type = "Goal"
[component.props]
game = { path = "." }
scorer = "enemy"

[[component]]
node = "Walls/Right"
type = "Transform"
[component.props]
position = { vec3 = [80.0, 0.0, 0.0] }

[[component]]
node = "Walls/Right"
type = "PlaneCollider"
[component.props]
normal = { vec3 = [-1.0, 0.0, 0.0] }

[[component]]
node = "Walls/Right"
type = "Goal"
[component.props]
game = { path = "." }
scorer = "player"

[[ext_resource]]
id = "1"
path = "res://ui/scoreboard.uxml"
type = "UXML"

[[ext_resource]]
id = "2"
path = "res://assets/white.masset"
type = "Material"

[[ext_resource]]
id = "3"
path = "res://assets/frictionless.masset"
type = "PhysicsMaterial"

[[ext_resource]]
id = "4"
path = "res://assets/bouncy.masset"
type = "PhysicsMaterial"

[[node]]
name = "Pong"

[[node]]
name = "Camera"
parent = "."

[[node]]
name = "Player"
parent = "."

[[node]]
name = "Enemy"
parent = "."

[[node]]
name = "Ball"
parent = "."

[[node]]
name = "Walls"
parent = "."

[[node]]
name = "Top"
parent = "Walls"

[[node]]
name = "Bottom"
parent = "Walls"

[[node]]
name = "Left"
parent = "Walls"

[[node]]
name = "Right"
parent = "Walls"
