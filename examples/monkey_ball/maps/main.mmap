[mmap]
format = 2
editor_version = "1.0.0"

[[component]]
node = "."
type = "Transform"

[[component]]
node = "GameManager"
type = "Transform"

[[component]]
node = "GameManager"
type = "GameManager"
[component.props]
fallLimit = -12.0
player = { path = "Player" }
timeLimit = 65.0

[[component]]
node = "GameManager"
type = "UIDocument"
[component.props]
panel_settings = { ext = "1" }
source_asset = { ext = "2" }

[[component]]
node = "Camera"
type = "Transform"
[component.props]
position = { vec3 = [0.0, 4.7, 7.0] }
rotation = { vec3 = [-22.0, 0.0, 0.0] }

[[component]]
node = "Camera"
type = "Camera"
[component.props]
background = { color = [0.42, 0.68, 0.92, 1.0] }
