cmake(
    name = "meshoptimizer_build",
    build_args = ["-j4"],
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "MESHOPT_BUILD_DEMO": "OFF",
        "MESHOPT_BUILD_GLTFPACK": "OFF",
        "MESHOPT_BUILD_SHARED_LIBS": "OFF",
        "MESHOPT_INSTALL": "ON",
        "MESHOPT_WERROR": "OFF",
    },
    lib_source = "@meshoptimizer_src//:all",
    out_static_libs = ["libmeshoptimizer.a"],
