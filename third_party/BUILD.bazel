cmake(
    name = "tinyxml2_build",
    build_args = ["-j4"],
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "tinyxml2_BUILD_TESTING": "OFF",
    },
    lib_source = "@tinyxml2_src//:all",
