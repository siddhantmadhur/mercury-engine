load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

# rules_foreign_cc's CMake toolchain leaves CMAKE_RANLIB empty on some hosts
# (notably Fedora), which turns the archive step into `ccache :`. Pin the
# system ranlib on Linux and macOS.
CMAKE_RANLIB_ARGS = select({
    "@platforms//os:linux": ["-DCMAKE_RANLIB=/usr/bin/ranlib"],
    "@platforms//os:macos": ["-DCMAKE_RANLIB=/usr/bin/ranlib"],
    "//conditions:default": [],
})

# Dependency builds are compiled through ccache when it is installed. The
# launcher is //tools:ccache_wrapper: .bazelrc exports CCACHE_DISABLE=1 to
# every Bazel action (the autoconf probes need it), and the wrapper clears that
# before handing over to ccache. Without ccache the wrapper just execs the
# compiler, so it is always safe to use. The disk cache still caches the
# resulting CMake actions.
CCACHE_LAUNCHER = "$$EXT_BUILD_ROOT$$/$(execpath //tools:ccache_wrapper)"
CCACHE_DATA = ["//tools:ccache_wrapper"]

# Environment shared by every rules_foreign_cc build.
#
# PYTHONDONTWRITEBYTECODE is required, not cosmetic: dependency builds execute
# Python helper scripts from their source tree (Filament generates
# spirv-tools' grammar tables that way). rules_foreign_cc exposes those sources
# to the sandbox through symlinks, so CPython would write __pycache__/*.pyc
# next to them - back into the external repository, and potentially into the
# git submodule itself. Because the sources are inputs of the CMake action, the
# new bytecode makes Bazel treat the dependency as dirty on the next build and
# repeat the whole configure/compile/install. Keeping it out of the tree stops
# that loop and leaves submodules untouched for `git submodule update`.
FOREIGN_CC_ENV = select({
    "@platforms//os:macos": {
        # rules_foreign_cc does not forward Bazel's --macos_minimum_os to CMake,
        # so dependency archives would otherwise be compiled for the host's
        # macOS version (the linker then warns "built for newer 'macOS'
        # version"). CMake initialises CMAKE_OSX_DEPLOYMENT_TARGET from this
        # environment variable. Keep the value in sync with --macos_minimum_os
        # in .bazelrc.
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "PYTHONDONTWRITEBYTECODE": "1",
    },
    "//conditions:default": {
        "PYTHONDONTWRITEBYTECODE": "1",
    },
})


# AngelScript is a plain C++ library with no code generation or external
# build system. It lives in its own git submodule, so the target is declared in
# this package (the submodule itself has no BUILD file).
cc_library(
    name = "angelscript",
    srcs = glob([
        "angelscript/sdk/angelscript/source/*.cpp",
        "angelscript/sdk/add_on/scriptbuilder/*.cpp",
        "angelscript/sdk/add_on/scriptarray/*.cpp",
        "angelscript/sdk/add_on/scriptstdstring/*.cpp",
        "angelscript/sdk/add_on/scriptmath/*.cpp",
        "angelscript/sdk/add_on/scriptdictionary/*.cpp",
    ]) + select({
        # Apple's assembler needs the Mach-O flavoured source; the GCC/GAS file
        # uses ELF directives (e.g. .type) that the macOS toolchain rejects.
        # Both files are wrapped in `#if defined(__aarch64__)`, so they assemble
        # to nothing on other CPUs.
        "@platforms//os:macos": [
            "angelscript/sdk/angelscript/source/as_callfunc_arm64_xcode.S",
        ],
        "@platforms//os:linux": [
            "angelscript/sdk/angelscript/source/as_callfunc_arm64_gcc.S",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob([
        "angelscript/sdk/angelscript/include/*.h",
        "angelscript/sdk/angelscript/source/*.h",
        "angelscript/sdk/add_on/scriptbuilder/*.h",
        "angelscript/sdk/add_on/scriptarray/*.h",
        "angelscript/sdk/add_on/scriptstdstring/*.h",
        "angelscript/sdk/add_on/scriptmath/*.h",
        "angelscript/sdk/add_on/scriptdictionary/*.h",
    ]),
    copts = [
        "-std=c++17",
        "-Wno-unused-parameter",
    ],
    includes = [
        "angelscript/sdk/angelscript/include",
        "angelscript/sdk/add_on",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "@platforms//os:macos": ["-lpthread"],
        "//conditions:default": [],
    }),
)

# --------------------------------------------------------------------------
# Header-only dependencies
#
# They keep their existing include layout so engine sources do not change:
#   #include "stb/stb_image.h", <glm/glm.hpp>, "nanosvg/src/nanosvg.h", ...
# --------------------------------------------------------------------------

cc_library(
    name = "stb",
    hdrs = glob(["stb/*.h"]),
    includes = ["."],
)

cc_library(
    name = "nanosvg",
    hdrs = glob(["nanosvg/src/*.h"]),
    includes = ["."],
)

cc_library(
    name = "glm",
    hdrs = glob([
        "glm/glm/**/*.h",
        "glm/glm/**/*.hpp",
        "glm/glm/**/*.inl",
    ]),
    includes = ["glm"],
)

cc_library(
    name = "vulkan_memory_allocator",
    hdrs = glob(["VulkanMemoryAllocator/include/*.h"]),
    includes = ["VulkanMemoryAllocator/include"],
)

cc_library(
    name = "jolt_headers",
    hdrs = glob([
        "JoltPhysics/Jolt/**/*.h",
        "JoltPhysics/Jolt/**/*.inl",
    ]),
    includes = ["JoltPhysics"],
)

cc_library(
    name = "assimp_headers",
    hdrs = glob([
        "assimp/code/**/*.h",
        "assimp/code/**/*.inl",
        "assimp/include/**/*.h",
        "assimp/include/**/*.hpp",
        "assimp/include/**/*.inl",
    ]),
    includes = [
        ".",
        "assimp/include",
    ],
)

cc_library(
    name = "glfw_headers",
    hdrs = glob(["glfw/include/**/*.h"]),
    includes = ["glfw/include"],
)

# entt is a Bazel package of its own (third_party/entt/BUILD.bazel is
# upstream) and its target already exposes <entt/entt.hpp>.
alias(
    name = "entt",
    actual = "//third_party/entt:entt",
)

# --------------------------------------------------------------------------
# Small dependencies built natively
#
# These are plain C/C++ libraries with no code generation, so Bazel compiles
# them directly instead of running a CMake configure + build + install action.
# That makes them incremental like the rest of the engine (a rules_foreign_cc
# action always restarts from zero) and avoids a subprocess-heavy configure
# step. Filament and assimp keep their CMake builds. The include layouts match
# the previous CMake install trees.
# --------------------------------------------------------------------------

cc_library(
    name = "tinyxml2_lib",
    srcs = ["tinyxml2/tinyxml2.cpp"],
    hdrs = ["tinyxml2/tinyxml2.h"],
    # tinyxml2's CMake target exports this publicly (large-file support).
    defines = ["_FILE_OFFSET_BITS=64"],
    # Consumers use <tinyxml2.h>; the same layout the install tree provided.
    includes = ["tinyxml2"],
)

cc_library(
    name = "meshoptimizer_lib",
    srcs = glob(["meshoptimizer/src/*.cpp"]),
    hdrs = glob(["meshoptimizer/src/*.h"]),
    # Consumers use "meshoptimizer/src/meshoptimizer.h".
    includes = ["."],
)

cc_library(
    name = "miniaudio_lib",
    srcs = ["miniaudio/miniaudio.c"],
    hdrs = glob(["miniaudio/*.h"]),
    # Match the options the CMake build passed.
    defines = [
        "MA_NO_ENCODING",
        "MA_NO_GENERATION",
    ],
    # Consumers use "miniaudio/miniaudio.h".
    includes = ["."],
)

cc_library(
    name = "yoga_lib",
    srcs = glob(["yoga/yoga/**/*.cpp"]),
    hdrs = glob(["yoga/yoga/**/*.h"]),
    # Consumers (and Yoga's own sources) use <yoga/...>.
    includes = ["yoga"],
)

# --------------------------------------------------------------------------
# Dependencies built by their own CMakeLists through rules_foreign_cc
# --------------------------------------------------------------------------

cmake(
    name = "glfw_build",
    build_args = ["-j4"],
    generate_args = ["-G Ninja"] + CMAKE_RANLIB_ARGS,
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "GLFW_BUILD_DOCS": "OFF",
        "GLFW_BUILD_EXAMPLES": "OFF",
        "GLFW_BUILD_TESTS": "OFF",
        "GLFW_INSTALL": "ON",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_C_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
        "CMAKE_CXX_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
    },
    data = CCACHE_DATA,
    # rules_foreign_cc gives pkg-config only its own dependency prefix; on
    # Linux the X11/Wayland .pc files live in the system directories.
    env = select({
        "@platforms//os:linux": {
            "PKG_CONFIG_PATH": "/usr/lib64/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/local/lib/pkgconfig:/usr/share/pkgconfig",
            "PYTHONDONTWRITEBYTECODE": "1",
        },
        "@platforms//os:macos": {
            "MACOSX_DEPLOYMENT_TARGET": "26.0",
            "PYTHONDONTWRITEBYTECODE": "1",
        },
        "//conditions:default": {"PYTHONDONTWRITEBYTECODE": "1"},
    }),
    lib_source = "@glfw_src//:all",
    out_static_libs = ["libglfw3.a"],
)

cc_library(
    name = "glfw",
    hdrs = [],
    linkopts = select({
        "@platforms//os:macos": [
            "-framework Cocoa",
            "-framework IOKit",
            "-framework CoreFoundation",
            "-framework QuartzCore",
        ],
        "@platforms//os:linux": [
            "-ldl",
            "-lm",
            "-lpthread",
            "-lX11",
            "-lXrandr",
            "-lXi",
            "-lXcursor",
            "-lXinerama",
            "-lwayland-client",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":glfw_build",
        ":glfw_headers",
    ],
)

cmake(
    name = "assimp_build",
    # Cap the per-action job count: Bazel can run several foreign_cc actions at
    # once (a full rebuild runs glfw/assimp/jolt/Filament together), and each
    # one spawning one compiler per core oversubscribes the machine badly.
    build_args = ["-j4"],
    cache_entries = {
        "ASSIMP_BUILD_ASSIMP_TOOLS": "OFF",
        "ASSIMP_BUILD_TESTS": "OFF",
        "ASSIMP_BUILD_ZLIB": "ON",
        "ASSIMP_INSTALL_PDB": "OFF",
        "ASSIMP_WARNINGS_AS_ERRORS": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_C_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
        "CMAKE_CXX_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
    },
    data = CCACHE_DATA,
    generate_args = select({
        # assimp's bundled zlib defines fdopen() NULL on macOS, which breaks
        # the SDK's declaration. The old CMake build applied this to zlibstatic.
        "@platforms//os:macos": [
            "-G Ninja",
            "-DCMAKE_RANLIB=/usr/bin/ranlib",
            "-DCMAKE_C_FLAGS:STRING=-Dfdopen=fdopen",
        ],
        "@platforms//os:linux": [
            "-G Ninja",
            "-DCMAKE_RANLIB=/usr/bin/ranlib",
        ],
        "//conditions:default": [
            "-G Ninja",
        ],
    }),
    env = FOREIGN_CC_ENV,
    lib_source = "@assimp_src//:all",
    out_static_libs = [
        "libassimp.a",
        "libzlibstatic.a",
    ],
)

cc_library(
    name = "assimp",
    linkopts = select({
        "@platforms//os:linux": ["-ldl", "-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":assimp_build",
        ":assimp_headers",
    ],
)

cmake(
    name = "jolt_build",
    build_args = ["-j4"],
    generate_args = ["-G Ninja"] + CMAKE_RANLIB_ARGS,
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "CPP_EXCEPTIONS_ENABLED": "OFF",
        "CPP_RTTI_ENABLED": "OFF",
        "DEBUG_RENDERER_IN_DEBUG_AND_RELEASE": "OFF",
        "ENABLE_ALL_WARNINGS": "OFF",
        "ENABLE_OBJECT_STREAM": "OFF",
        "INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "PROFILER_IN_DEBUG_AND_RELEASE": "OFF",
        "JPH_USE_CPU_COMPUTE": "OFF",
        "JPH_USE_DX12": "OFF",
        "JPH_USE_DXC": "OFF",
        "JPH_USE_MTL": "OFF",
        "JPH_USE_VK": "OFF",
        "TARGET_HELLO_WORLD": "OFF",
        "TARGET_PERFORMANCE_TEST": "OFF",
        "TARGET_SAMPLES": "OFF",
        "TARGET_UNIT_TESTS": "OFF",
        "TARGET_VIEWER": "OFF",
        "USE_ASSERTS": "OFF",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_C_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
        "CMAKE_CXX_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
    },
    data = CCACHE_DATA,
    env = FOREIGN_CC_ENV,
    lib_source = "@jolt_src//:all",
    out_static_libs = ["libJolt.a"],
    working_directory = "Build",
)

cc_library(
    name = "jolt",
    # These are Jolt's PUBLIC compile definitions for a Release build with
    # defaults; Jolt's version check aborts if the client disagrees.
    defines = [
        "JPH_OBJECT_LAYER_BITS=16",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":jolt_build",
        ":jolt_headers",
    ],
)

cc_library(
    name = "yoga",
    deps = [":yoga_lib"],
)

cc_library(
    name = "tinyxml2",
    deps = [":tinyxml2_lib"],
)

cc_library(
    name = "meshoptimizer",
    deps = [":meshoptimizer_lib"],
)

cmake(
    name = "filament_build",
    # Filament installs its libraries under lib/<arch>.
    out_lib_dir = select({
        "@platforms//os:macos": "lib/arm64",
        "@platforms//os:linux": "lib/x86_64",
        "//conditions:default": "lib",
    }),
    generate_args = ["-G Ninja"] + CMAKE_RANLIB_ARGS + [
        # Filament's CMakeLists overrides CMAKE_*_ARCHIVE_CREATE with
        # "<CMAKE_AR> qc -S", which the Bazel toolchain's libtool wrapper
        # rejects; pin the plain Apple archiver instead.
        "-DCMAKE_AR=/usr/bin/ar",
        "-DCMAKE_RANLIB=/usr/bin/ranlib",
    ],
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "FILAMENT_BUILD_TESTING": "OFF",
        "FILAMENT_SKIP_SAMPLES": "ON",
        "FILAMENT_SKIP_SDL2": "ON",
        "FILAMENT_SUPPORTS_METAL": "OFF",
        "FILAMENT_SUPPORTS_OPENGL": "OFF",
        "FILAMENT_SUPPORTS_VULKAN": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
        "CMAKE_CXX_COMPILER_LAUNCHER": CCACHE_LAUNCHER,
    },
    data = CCACHE_DATA,
    env = FOREIGN_CC_ENV,
    lib_source = "@filament_src//:all",
    out_binaries = ["matc"],
    out_include_dir = "include",
    out_static_libs = [
        "libfilament.a",
        "libbackend.a",
        "libbluevk.a",
        "libfilaflat.a",
        "libfilabridge.a",
        "libsmol-v.a",
        "libutils.a",
        "libzstd.a",
        "libgeometry.a",
        "libibl.a",
        "libimage.a",
        "libfilament-iblprefilter.a",
    ],
)

# Filament dlopen()s the Vulkan loader (bluevk); linking Mercury's loader
# target also adds the SDK rpath that lets that call succeed.
cc_library(
    name = "filament",
    deps = [
        ":filament_build",
        "@vulkan//:vulkan",
    ],
    linkopts = select({
        "@platforms//os:macos": [
            "-framework CoreFoundation",
            "-framework Foundation",
        ],
        "@platforms//os:linux": ["-lpthread", "-ldl"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "miniaudio",
    linkopts = select({
        "@platforms//os:linux": ["-ldl", "-lm", "-lpthread"],
        "@platforms//os:macos": [
            "-framework AudioToolbox",
            "-framework CoreAudio",
            "-framework CoreFoundation",
        ],
        "//conditions:default": [],
    }),
    deps = [":miniaudio_lib"],
)
