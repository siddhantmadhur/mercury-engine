cc_library(
    name = "miniaudio",
    linkopts = select({
        "@platforms//os:linux": ["-ldl", "-lm", "-lpthread"],
        "@platforms//os:macos": [
            "-framework AudioToolbox",
            "-framework CoreAudio",
            "-framework CoreFoundation",
        ],
        "//conditions:default": [],
