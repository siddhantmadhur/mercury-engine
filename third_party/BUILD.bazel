load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

# rules_foreign_cc's CMake toolchain leaves CMAKE_RANLIB empty on some hosts
# (notably Fedora), which turns the archive step into `ccache :`. Pin the
# system ranlib on Linux and macOS.
CMAKE_RANLIB_ARGS = select({
    "@platforms//os:linux": ["-DCMAKE_RANLIB=/usr/bin/ranlib"],
    "@platforms//os:macos": ["-DCMAKE_RANLIB=/usr/bin/ranlib"],
    "//conditions:default": [],
})


# AngelScript is a plain C++ library with no code generation or external
# build system. It lives in its own git submodule, so the target is declared in
# this package (the submodule itself has no BUILD file).
cc_library(
    name = "angelscript",
    srcs = glob([
        "angelscript/sdk/angelscript/source/*.cpp",
        "angelscript/sdk/add_on/scriptbuilder/*.cpp",
        "angelscript/sdk/add_on/scriptarray/*.cpp",
        "angelscript/sdk/add_on/scriptstdstring/*.cpp",
        "angelscript/sdk/add_on/scriptmath/*.cpp",
        "angelscript/sdk/add_on/scriptdictionary/*.cpp",
    ]) + select({
        # Apple's assembler needs the Mach-O flavoured source; the GCC/GAS file
        # uses ELF directives (e.g. .type) that the macOS toolchain rejects.
        # Both files are wrapped in `#if defined(__aarch64__)`, so they assemble
        # to nothing on other CPUs.
        "@platforms//os:macos": [
            "angelscript/sdk/angelscript/source/as_callfunc_arm64_xcode.S",
        ],
        "@platforms//os:linux": [
            "angelscript/sdk/angelscript/source/as_callfunc_arm64_gcc.S",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob([
        "angelscript/sdk/angelscript/include/*.h",
        "angelscript/sdk/angelscript/source/*.h",
        "angelscript/sdk/add_on/scriptbuilder/*.h",
        "angelscript/sdk/add_on/scriptarray/*.h",
        "angelscript/sdk/add_on/scriptstdstring/*.h",
        "angelscript/sdk/add_on/scriptmath/*.h",
        "angelscript/sdk/add_on/scriptdictionary/*.h",
    ]),
    copts = [
        "-std=c++17",
        "-Wno-unused-parameter",
    ],
    includes = [
        "angelscript/sdk/angelscript/include",
        "angelscript/sdk/add_on",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "@platforms//os:macos": ["-lpthread"],
        "//conditions:default": [],
    }),
)

# --------------------------------------------------------------------------
# Header-only dependencies
#
# They keep their existing include layout so engine sources do not change:
#   #include "stb/stb_image.h", <glm/glm.hpp>, "nanosvg/src/nanosvg.h", ...
# --------------------------------------------------------------------------

cc_library(
    name = "stb",
    hdrs = glob(["stb/*.h"]),
    includes = ["."],
)

cc_library(
    name = "nanosvg",
    hdrs = glob(["nanosvg/src/*.h"]),
    includes = ["."],
)

cc_library(
    name = "glm",
    hdrs = glob([
        "glm/glm/**/*.h",
        "glm/glm/**/*.hpp",
        "glm/glm/**/*.inl",
    ]),
    includes = ["glm"],
)

cc_library(
    name = "vulkan_memory_allocator",
    hdrs = glob(["VulkanMemoryAllocator/include/*.h"]),
    includes = ["VulkanMemoryAllocator/include"],
)

cc_library(
    name = "jolt_headers",
    hdrs = glob([
        "JoltPhysics/Jolt/**/*.h",
        "JoltPhysics/Jolt/**/*.inl",
    ]),
    includes = ["JoltPhysics"],
)

cc_library(
    name = "assimp_headers",
    hdrs = glob([
        "assimp/code/**/*.h",
        "assimp/code/**/*.inl",
        "assimp/include/**/*.h",
        "assimp/include/**/*.hpp",
        "assimp/include/**/*.inl",
    ]),
    includes = [
        ".",
        "assimp/include",
    ],
)

cc_library(
    name = "yoga_headers",
    hdrs = glob(["yoga/yoga/**/*.h"]),
    includes = ["yoga"],
)

cc_library(
    name = "tinyxml2_headers",
    hdrs = glob(["tinyxml2/*.h"]),
    includes = ["tinyxml2"],
)

cc_library(
    name = "meshoptimizer_headers",
    hdrs = glob(["meshoptimizer/src/*.h"]),
    includes = ["."],
)

cc_library(
    name = "miniaudio_headers",
    hdrs = glob(["miniaudio/*.h"]),
    includes = ["."],
)

cc_library(
    name = "glfw_headers",
    hdrs = glob(["glfw/include/**/*.h"]),
    includes = ["glfw/include"],
)

# entt is a Bazel package of its own (third_party/entt/BUILD.bazel is
# upstream) and its target already exposes <entt/entt.hpp>.
alias(
    name = "entt",
    actual = "//third_party/entt:entt",
)

# --------------------------------------------------------------------------
# Dependencies built by their own CMakeLists through rules_foreign_cc
# --------------------------------------------------------------------------

cmake(
    name = "glfw_build",
    build_args = ["-j4"],
    generate_args = CMAKE_RANLIB_ARGS,
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "GLFW_BUILD_DOCS": "OFF",
        "GLFW_BUILD_EXAMPLES": "OFF",
        "GLFW_BUILD_TESTS": "OFF",
        "GLFW_INSTALL": "ON",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
    },
    # rules_foreign_cc gives pkg-config only its own dependency prefix; on
    # Linux the X11/Wayland .pc files live in the system directories.
    env = select({
        "@platforms//os:linux": {
            "PKG_CONFIG_PATH": "/usr/lib64/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/local/lib/pkgconfig:/usr/share/pkgconfig",
        },
        "//conditions:default": {},
    }),
    lib_source = "@glfw_src//:all",
    out_static_libs = ["libglfw3.a"],
)

cc_library(
    name = "glfw",
    hdrs = [],
    linkopts = select({
        "@platforms//os:macos": [
            "-framework Cocoa",
            "-framework IOKit",
            "-framework CoreFoundation",
            "-framework QuartzCore",
        ],
        "@platforms//os:linux": [
            "-ldl",
            "-lm",
            "-lpthread",
            "-lX11",
            "-lXrandr",
            "-lXi",
            "-lXcursor",
            "-lXinerama",
            "-lwayland-client",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":glfw_build",
        ":glfw_headers",
    ],
)

cmake(
    name = "assimp_build",
    build_args = ["-j4"],
    cache_entries = {
        "ASSIMP_BUILD_ASSIMP_TOOLS": "OFF",
        "ASSIMP_BUILD_TESTS": "OFF",
        "ASSIMP_BUILD_ZLIB": "ON",
        "ASSIMP_INSTALL_PDB": "OFF",
        "ASSIMP_WARNINGS_AS_ERRORS": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
    },
    generate_args = select({
        # assimp's bundled zlib defines fdopen() NULL on macOS, which breaks
        # the SDK's declaration. The old CMake build applied this to zlibstatic.
        "@platforms//os:macos": [
            "-DCMAKE_RANLIB=/usr/bin/ranlib",
            "-DCMAKE_C_FLAGS:STRING=-Dfdopen=fdopen",
        ],
        "@platforms//os:linux": ["-DCMAKE_RANLIB=/usr/bin/ranlib"],
        "//conditions:default": [],
    }),
    lib_source = "@assimp_src//:all",
    out_static_libs = [
        "libassimp.a",
        "libzlibstatic.a",
    ],
)

cc_library(
    name = "assimp",
    linkopts = select({
        "@platforms//os:linux": ["-ldl", "-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":assimp_build",
        ":assimp_headers",
    ],
)

cmake(
    name = "jolt_build",
    build_args = ["-j4"],
    generate_args = CMAKE_RANLIB_ARGS,
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "CPP_EXCEPTIONS_ENABLED": "OFF",
        "CPP_RTTI_ENABLED": "OFF",
        "DEBUG_RENDERER_IN_DEBUG_AND_RELEASE": "OFF",
        "ENABLE_ALL_WARNINGS": "OFF",
        "ENABLE_OBJECT_STREAM": "OFF",
        "INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "PROFILER_IN_DEBUG_AND_RELEASE": "OFF",
        "JPH_USE_CPU_COMPUTE": "OFF",
        "JPH_USE_DX12": "OFF",
        "JPH_USE_DXC": "OFF",
        "JPH_USE_MTL": "OFF",
        "JPH_USE_VK": "OFF",
        "TARGET_HELLO_WORLD": "OFF",
        "TARGET_PERFORMANCE_TEST": "OFF",
        "TARGET_SAMPLES": "OFF",
        "TARGET_UNIT_TESTS": "OFF",
        "TARGET_VIEWER": "OFF",
        "USE_ASSERTS": "OFF",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
    },
    lib_source = "@jolt_src//:all",
    out_static_libs = ["libJolt.a"],
    working_directory = "Build",
)

cc_library(
    name = "jolt",
    # These are Jolt's PUBLIC compile definitions for a Release build with
    # defaults; Jolt's version check aborts if the client disagrees.
    defines = [
        "JPH_OBJECT_LAYER_BITS=16",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":jolt_build",
        ":jolt_headers",
    ],
)

