cmake(
    name = "yoga_build",
    build_args = ["-j4"],
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
    },
    lib_source = "@yoga_src//:all",
    out_static_libs = ["libyogacore.a"],
    working_directory = "yoga",
)

cc_library(
    name = "yoga",
    deps = [
        ":yoga_build",
        ":yoga_headers",
    ],
