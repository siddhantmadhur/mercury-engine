package(default_visibility = ["//visibility:public"])

exports_files(["patches/highway_rules_cc.patch"])

# The default backend is V8's own Bazel build (@v8//:v8_noicu). If that
# cannot be made to work on a host, --define=v8_backend=gn uses the monolithic
# library produced by scripts/build_v8.sh instead.
config_setting(
    name = "use_gn_monolith",
    values = {"define": "v8_backend=gn"},
)

alias(
    name = "v8",
    actual = select({
        ":use_gn_monolith": "@v8_gn//:v8",
        "//conditions:default": "@v8//:v8_noicu",
    }),
)
