is_debug = false
is_component_build = false
v8_monolithic = true
v8_use_external_startup_data = false
use_custom_libcxx = false          # link against the system libstdc++/MSVC STL like the engine does
treat_warnings_as_errors = false
v8_enable_i18n_support = false     # no ICU: smaller, and games don't need Intl
v8_enable_pointer_compression = false
v8_enable_sandbox = false          # with pointer compression off, no V8_* defines need to match
v8_enable_temporal_support = false # avoids the Rust toolchain dependency
v8_enable_webassembly = false
symbol_level = 1
