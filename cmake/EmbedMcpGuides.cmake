# Embeds the MCP guide templates (editor/mcp/guides/*.md) into a generated C++
# source, so the editor serves them without looking anything up at run time.
# Run at build time, with cmake -P, by a custom command that depends on the
# .md files, so editing a template regenerates the source:
#
#   cmake -DGUIDES_DIR=<editor/mcp/guides> -DOUTPUT=<out.cc> -P EmbedMcpGuides.cmake
#
# Each file becomes `const std::string_view <symbol>` in Mercury::mcp::guides
# (declared in editor/mcp/tools/guide_templates.h), written as raw string
# literals of at most 4000 characters each: adjacent literals concatenate, and
# compilers (MSVC in particular) limit the length of a single literal. The
# templates must be plain ASCII, so a chunk boundary never splits a UTF-8
# character, and must not contain the raw-string delimiter.

if (NOT GUIDES_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "EmbedMcpGuides.cmake needs -DGUIDES_DIR and -DOUTPUT")
endif ()

set(_delimiter "MCPGUIDE")
set(_chunk_size 4000)

set(_files common agents claude gemini)
set(_symbols kCommon kAgents kClaude kGemini)

set(_out "// Generated by cmake/EmbedMcpGuides.cmake from editor/mcp/guides/*.md.\n")
string(APPEND _out "// Do not edit: change the .md files instead.\n\n")
string(APPEND _out "#include \"mcp/tools/guide_templates.h\"\n\n")
string(APPEND _out "namespace Mercury::mcp::guides {\n\n")

list(LENGTH _files _count)
math(EXPR _last "${_count} - 1")
foreach (_i RANGE ${_last})
    list(GET _files ${_i} _file)
    list(GET _symbols ${_i} _symbol)
    set(_path "${GUIDES_DIR}/${_file}.md")
    if (NOT EXISTS "${_path}")
        message(FATAL_ERROR "missing guide template ${_path}")
    endif ()
    file(READ "${_path}" _content)

    string(REGEX MATCH "[^\t\n -~]" _bad "${_content}")
    if (_bad)
        message(FATAL_ERROR
                "${_path} has a character outside printable ASCII; the guide "
                "templates must be ASCII so they can be chunked safely")
    endif ()
    string(FIND "${_content}" ")${_delimiter}" _collision)
    if (NOT _collision EQUAL -1)
        message(FATAL_ERROR
                "${_path} contains \")${_delimiter}\", the raw string delimiter")
    endif ()

    string(APPEND _out "const std::string_view ${_symbol} =")
    string(LENGTH "${_content}" _length)
    set(_offset 0)
    while (_offset LESS _length)
        math(EXPR _remaining "${_length} - ${_offset}")
        if (_remaining GREATER _chunk_size)
            set(_take ${_chunk_size})
        else ()
            set(_take ${_remaining})
        endif ()
        string(SUBSTRING "${_content}" ${_offset} ${_take} _chunk)
        string(APPEND _out "\n    R\"${_delimiter}(${_chunk})${_delimiter}\"")
        math(EXPR _offset "${_offset} + ${_take}")
    endwhile ()
    if (_length EQUAL 0)
        string(APPEND _out " \"\"")
    endif ()
    string(APPEND _out ";\n\n")
endforeach ()

string(APPEND _out "}  // namespace Mercury::mcp::guides\n")
file(WRITE "${OUTPUT}" "${_out}")
