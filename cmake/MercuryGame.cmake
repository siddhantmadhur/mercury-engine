# mercury_add_game(<target> PROJECT <dir> [SOURCES <extra.cc>...])
#
# Builds a player executable for a Mercury project whose gameplay is C++:
#   - every .cc/.cpp under <dir>/src is compiled in (new files are picked up
#     on the next configure thanks to CONFIGURE_DEPENDS),
#   - main() opens <dir>/<name>.mproj by default,
#   - the executable is written to <build>/bin/<target>, which is where the
#     editor looks for it (see editor/play_session.cc).
#
# C++ sources under scripts/ are no longer compiled; move them to src/.
#
# A project inside this checkout can add its directory from the top-level
# CMakeLists.txt. A project outside it can add the engine as a subdirectory
# and call this function from its own CMakeLists.txt.

function(mercury_add_game TARGET)
    cmake_parse_arguments(GAME "" "PROJECT" "SOURCES" ${ARGN})
    if (NOT GAME_PROJECT)
        message(FATAL_ERROR "mercury_add_game(${TARGET}) needs PROJECT <dir>")
    endif ()
    get_filename_component(GAME_PROJECT "${GAME_PROJECT}" ABSOLUTE)

    file(GLOB GAME_MPROJ "${GAME_PROJECT}/*.mproj")
    list(LENGTH GAME_MPROJ GAME_MPROJ_COUNT)
    if (NOT GAME_MPROJ_COUNT EQUAL 1)
        message(FATAL_ERROR
                "mercury_add_game(${TARGET}): expected one .mproj in ${GAME_PROJECT}")
    endif ()
    list(GET GAME_MPROJ 0 GAME_MPROJ_FILE)

    file(GLOB_RECURSE GAME_SCRIPTS CONFIGURE_DEPENDS
            "${GAME_PROJECT}/src/*.cc"
            "${GAME_PROJECT}/src/*.cpp")
    file(GLOB_RECURSE GAME_LEGACY_SCRIPTS
            "${GAME_PROJECT}/scripts/*.cc"
            "${GAME_PROJECT}/scripts/*.cpp")
    if (GAME_LEGACY_SCRIPTS)
        message(WARNING
                "mercury_add_game(${TARGET}): C++ files under "
                "${GAME_PROJECT}/scripts are no longer compiled; move them "
                "to ${GAME_PROJECT}/src.")
    endif ()

    # Embed the project path as a C string without letting a quote or a
    # backslash in the folder name break out of the literal.
    string(REPLACE "\\" "\\\\" GAME_MPROJ_ESCAPED "${GAME_MPROJ_FILE}")
    string(REPLACE "\"" "\\\"" GAME_MPROJ_ESCAPED "${GAME_MPROJ_ESCAPED}")
    set(GAME_MAIN "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_main.cc")
    file(CONFIGURE OUTPUT "${GAME_MAIN}" CONTENT
            "// Generated by mercury_add_game; do not edit.\n#include \"player/player.h\"\n\nint main(int argc, char** argv) {\n  return Mercury::RunPlayer(argc, argv, \"${GAME_MPROJ_ESCAPED}\");\n}\n")

    add_executable(${TARGET} ${GAME_MAIN} ${GAME_SCRIPTS} ${GAME_SOURCES})
    target_include_directories(${TARGET} PRIVATE "${GAME_PROJECT}/src")
    target_link_libraries(${TARGET} PRIVATE mercury)
    # Games always link the plain Rust archive; the MCP transport is
    # editor-only (see cmake/Rust.cmake).
    mercury_link_rust(${TARGET})
    set_target_properties(${TARGET} PROPERTIES
            OUTPUT_NAME "${TARGET}"
            RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
            EXPORT_COMPILE_COMMANDS ON
            CXX_SCAN_FOR_MODULES OFF)
endfunction()

# mercury_add_editor_system(<target> PROJECT <dir> [SOURCES <extra.cc>...])
#
# Builds the project's editor extensions from <dir>/system into a MODULE
# library the editor loads when the project opens. The module is not linked
# against the engine or the editor: its symbols (engine, editor and wxWidgets)
# resolve against the running editor at load time. Because of that the editor
# executable must be built in the same tree, and the target is added only when
# MERCURY_BUILD_EDITOR is on.
#
# The library is written to <dir>/.mercury/systems, where
# EditorExtensionLoader looks for it. The editor derives the target name from
# the project's [build] target: for [build] target = "my_game" it builds
# "my_game_systems".
function(mercury_add_editor_system TARGET)
    cmake_parse_arguments(SYSTEM "" "PROJECT" "SOURCES" ${ARGN})
    if (NOT SYSTEM_PROJECT)
        message(FATAL_ERROR
                "mercury_add_editor_system(${TARGET}) needs PROJECT <dir>")
    endif ()
    if (NOT TARGET mercury_wx_headers)
        message(FATAL_ERROR
                "mercury_add_editor_system(${TARGET}) needs an editor build "
                "(configure the engine with MERCURY_BUILD_EDITOR=ON)")
    endif ()
    get_filename_component(SYSTEM_PROJECT "${SYSTEM_PROJECT}" ABSOLUTE)

    file(GLOB_RECURSE SYSTEM_GLOB_SOURCES CONFIGURE_DEPENDS
            "${SYSTEM_PROJECT}/system/*.cc"
            "${SYSTEM_PROJECT}/system/*.cpp")
    if (NOT SYSTEM_GLOB_SOURCES AND NOT SYSTEM_SOURCES)
        # A project without editor extensions still uses the same CMakeLists.
        return()
    endif ()

    add_library(${TARGET} MODULE ${SYSTEM_GLOB_SOURCES} ${SYSTEM_SOURCES})
    target_compile_features(${TARGET} PRIVATE cxx_std_20)
    target_include_directories(${TARGET} PRIVATE
            "${SYSTEM_PROJECT}/system"
            "${MERCURY_ENGINE_SOURCE_DIR}/editor"
            $<TARGET_PROPERTY:mercury,INTERFACE_INCLUDE_DIRECTORIES>)
    target_compile_definitions(${TARGET} PRIVATE
            $<TARGET_PROPERTY:mercury,INTERFACE_COMPILE_DEFINITIONS>)
    target_link_libraries(${TARGET} PRIVATE mercury_wx_headers)
    if (APPLE)
        # Resolve engine/editor/wx symbols from the executable that loads us.
        target_link_options(${TARGET} PRIVATE "-Wl,-undefined,dynamic_lookup")
    endif ()
    set_target_properties(${TARGET} PROPERTIES
            PREFIX ""
            LIBRARY_OUTPUT_DIRECTORY "${SYSTEM_PROJECT}/.mercury/systems"
            RUNTIME_OUTPUT_DIRECTORY "${SYSTEM_PROJECT}/.mercury/systems"
            CXX_SCAN_FOR_MODULES OFF)
    # The top-level project sets CMAKE_LIBRARY_OUTPUT_DIRECTORY_<CONFIG> for
    # every target, and a per-config value wins over the generic property.
    foreach (CONFIG Debug Release RelWithDebInfo MinSizeRel)
        string(TOUPPER "${CONFIG}" CONFIG_UPPER)
        set_target_properties(${TARGET} PROPERTIES
                "LIBRARY_OUTPUT_DIRECTORY_${CONFIG_UPPER}"
                "${SYSTEM_PROJECT}/.mercury/systems"
                "RUNTIME_OUTPUT_DIRECTORY_${CONFIG_UPPER}"
                "${SYSTEM_PROJECT}/.mercury/systems")
    endforeach ()
endfunction()
