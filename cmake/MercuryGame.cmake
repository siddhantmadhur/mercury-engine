# mercury_add_game(<target> PROJECT <dir> [SOURCES <extra.cc>...])
#
# Builds the player executable for a Mercury project:
#   - every .cc/.cpp under <dir>/scripts is compiled in (new script files are
#     picked up on the next build thanks to CONFIGURE_DEPENDS),
#   - main() opens <dir>/<name>.mproj by default,
#   - <dir>/.mercury/player.mcfg tells the editor how to build and run it,
#   - the scripts land in compile_commands.json, for clangd.
function(mercury_add_game TARGET)
    cmake_parse_arguments(GAME "" "PROJECT" "SOURCES" ${ARGN})
    if (NOT GAME_PROJECT)
        message(FATAL_ERROR "mercury_add_game(${TARGET}) needs PROJECT <dir>")
    endif ()
    get_filename_component(GAME_PROJECT "${GAME_PROJECT}" ABSOLUTE)

    file(GLOB GAME_MPROJ "${GAME_PROJECT}/*.mproj")
    list(LENGTH GAME_MPROJ GAME_MPROJ_COUNT)
    if (NOT GAME_MPROJ_COUNT EQUAL 1)
        message(FATAL_ERROR
                "mercury_add_game(${TARGET}): expected one .mproj in ${GAME_PROJECT}")
    endif ()

    file(GLOB_RECURSE GAME_SCRIPTS CONFIGURE_DEPENDS
            "${GAME_PROJECT}/scripts/*.cc"
            "${GAME_PROJECT}/scripts/*.cpp")

    set(GAME_MAIN "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_main.cc")
    file(CONFIGURE OUTPUT "${GAME_MAIN}" CONTENT
            "// Generated by mercury_add_game; do not edit.\n#include \"player/player.h\"\n\nint main(int argc, char** argv) {\n  return Mercury::RunPlayer(argc, argv, \"${GAME_MPROJ}\");\n}\n")

    add_executable(${TARGET} ${GAME_MAIN} ${GAME_SCRIPTS} ${GAME_SOURCES})
    target_include_directories(${TARGET} PRIVATE "${GAME_PROJECT}/scripts")
    target_link_libraries(${TARGET} PRIVATE mercury)
    # The engine's CMAKE_* settings stay in its own directory, but a game
    # target is made in the game's CMakeLists.txt, so set them here.
    set_target_properties(${TARGET} PROPERTIES
            EXPORT_COMPILE_COMMANDS ON
            CXX_SCAN_FOR_MODULES OFF)

    if (EMSCRIPTEN)
        # The engine's UI resources (default font and theme) are read from
        # MERCURY_UI_RESOURCE_PATH, so ship them at the same path.
        get_target_property(MERCURY_SOURCE mercury SOURCE_DIR)
        set(MERCURY_UI_RESOURCES "${MERCURY_SOURCE}/mercury/ui/resources")
        set_target_properties(${TARGET} PROPERTIES SUFFIX ".html")
        target_link_options(${TARGET} PRIVATE
                "--shell-file" "${CMAKE_SOURCE_DIR}/web/shell.html"
                # SHELL: keeps CMake from merging the repeated flag.
                "SHELL:--preload-file ${GAME_PROJECT}@${GAME_PROJECT}"
                "SHELL:--preload-file ${MERCURY_UI_RESOURCES}@${MERCURY_UI_RESOURCES}"
                "-sALLOW_MEMORY_GROWTH=1"
                "-sNO_EXIT_RUNTIME=1"
        )
    endif ()

    # Multi-config generators (Visual Studio) get one file per configuration.
    get_property(MULTI_CONFIG GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if (MULTI_CONFIG)
        set(GAME_MCFG "${GAME_PROJECT}/.mercury/player-$<CONFIG>.mcfg")
    else ()
        set(GAME_MCFG "${GAME_PROJECT}/.mercury/player.mcfg")
    endif ()
    file(GENERATE OUTPUT "${GAME_MCFG}" CONTENT
            "[player]\nexecutable = \"$<TARGET_FILE:${TARGET}>\"\nbuild_dir = \"${CMAKE_BINARY_DIR}\"\ntarget = \"${TARGET}\"\nconfig = \"$<CONFIG>\"\n")
endfunction()
