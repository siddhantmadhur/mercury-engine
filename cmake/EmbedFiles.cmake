# Turns text files into a C++ source with an array of {path, bytes}, run by add_custom_command:
#   cmake -DOUT=<file.cc> -DROOT=<dir> -DFILES="a.ts;b/c.ts" -P EmbedFiles.cmake
# Bytes are written as numbers, so there is no string literal size limit (MSVC has one).
set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include \"scripting/ts_types.h\"\n\n")
string(APPEND content "namespace Mercury {\n\n")
set(index 0)
set(table "")
foreach (file ${FILES})
    file(READ "${ROOT}/${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "static const unsigned char kFile${index}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${file}\", kFile${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach ()
string(APPEND content "const EmbeddedFile kTsRuntimeFiles[] = {\n${table}};\n")
string(APPEND content "const size_t kTsRuntimeFileCount = ${index};\n}  // namespace Mercury\n")
file(WRITE "${OUT}.tmp" "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
