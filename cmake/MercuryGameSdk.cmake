# MercuryGame.cmake (installed SDK)
#
# mercury_add_game / mercury_add_editor_system for a project built against an
# installed Mercury SDK. MercuryConfig.cmake sets Mercury_INCLUDE_DIRS and
# Mercury_LIBRARIES before including this file, so these functions do not
# depend on an engine checkout or absolute build paths.
#
# The in-tree cmake/MercuryGame.cmake is different: it assumes the `mercury`
# target exists in the same build.

# mercury_add_game(<target> PROJECT <dir> [SOURCES <extra.cc>...])
function(mercury_add_game TARGET)
    cmake_parse_arguments(GAME "" "PROJECT" "SOURCES" ${ARGN})
    if (NOT GAME_PROJECT)
        message(FATAL_ERROR "mercury_add_game(${TARGET}) needs PROJECT <dir>")
    endif ()
    get_filename_component(GAME_PROJECT "${GAME_PROJECT}" ABSOLUTE)

    file(GLOB GAME_MPROJ "${GAME_PROJECT}/*.mproj")
    list(LENGTH GAME_MPROJ GAME_MPROJ_COUNT)
    if (NOT GAME_MPROJ_COUNT EQUAL 1)
        message(FATAL_ERROR
                "mercury_add_game(${TARGET}): expected one .mproj in ${GAME_PROJECT}")
    endif ()
    list(GET GAME_MPROJ 0 GAME_MPROJ_FILE)

    file(GLOB_RECURSE GAME_SCRIPTS CONFIGURE_DEPENDS
            "${GAME_PROJECT}/scripts/*.cc"
            "${GAME_PROJECT}/scripts/*.cpp"
            "${GAME_PROJECT}/src/*.cc"
            "${GAME_PROJECT}/src/*.cpp")

    set(GAME_MAIN "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_main.cc")
    file(CONFIGURE OUTPUT "${GAME_MAIN}" CONTENT
            "// Generated by mercury_add_game; do not edit.\n#include \"player/player.h\"\n\nint main(int argc, char** argv) {\n  return Mercury::RunPlayer(argc, argv, \"${GAME_MPROJ_FILE}\");\n}\n")

    add_executable(${TARGET} ${GAME_MAIN} ${GAME_SCRIPTS} ${GAME_SOURCES})
    target_include_directories(${TARGET} PRIVATE
            ${Mercury_INCLUDE_DIRS}
            "${GAME_PROJECT}/scripts"
            "${GAME_PROJECT}/src")
    target_compile_features(${TARGET} PRIVATE cxx_std_20)
    target_compile_definitions(${TARGET} PRIVATE
            MERCURY_GRAPHICS_VULKAN=1
            GLFW_INCLUDE_VULKAN=1
            GLM_FORCE_DEPTH_ZERO_TO_ONE=1)

    if (APPLE)
        target_link_libraries(${TARGET} PRIVATE
                ${Mercury_LIBRARIES}
                Vulkan::Vulkan Threads::Threads
                "-framework AppKit" "-framework Cocoa"
                "-framework CoreFoundation" "-framework IOKit"
                "-framework Metal" "-framework QuartzCore" "-lobjc")
        if (Vulkan_LIBRARY)
            get_filename_component(MERCURY_VK_DIR "${Vulkan_LIBRARY}" DIRECTORY)
            target_link_options(${TARGET} PRIVATE "-Wl,-rpath,${MERCURY_VK_DIR}")
        endif ()
    else ()
        target_link_libraries(${TARGET} PRIVATE
                ${Mercury_LIBRARIES}
                Vulkan::Vulkan Threads::Threads ${CMAKE_DL_LIBS})
    endif ()

    set_target_properties(${TARGET} PROPERTIES
            OUTPUT_NAME "${TARGET}"
            RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
            EXPORT_COMPILE_COMMANDS ON
            CXX_SCAN_FOR_MODULES OFF)
endfunction()

# mercury_add_editor_system(<target> PROJECT <dir> [SOURCES <extra.cc>...])
#
# Builds <dir>/system into a MODULE the editor loads. Engine, editor and wx
# symbols resolve against the running editor, so the module links no Mercury or
# wx libraries.
function(mercury_add_editor_system TARGET)
    cmake_parse_arguments(SYSTEM "" "PROJECT" "SOURCES" ${ARGN})
    if (NOT SYSTEM_PROJECT)
        message(FATAL_ERROR
                "mercury_add_editor_system(${TARGET}) needs PROJECT <dir>")
    endif ()
    get_filename_component(SYSTEM_PROJECT "${SYSTEM_PROJECT}" ABSOLUTE)

    find_package(wxWidgets REQUIRED COMPONENTS core base aui propgrid adv
            richtext stc)

    file(GLOB_RECURSE SYSTEM_GLOB_SOURCES CONFIGURE_DEPENDS
            "${SYSTEM_PROJECT}/system/*.cc"
            "${SYSTEM_PROJECT}/system/*.cpp")

    add_library(${TARGET} MODULE ${SYSTEM_GLOB_SOURCES} ${SYSTEM_SOURCES})
    target_compile_features(${TARGET} PRIVATE cxx_std_20)
    target_include_directories(${TARGET} PRIVATE
            ${Mercury_INCLUDE_DIRS}
            "${SYSTEM_PROJECT}/system")
    target_compile_definitions(${TARGET} PRIVATE
            MERCURY_GRAPHICS_VULKAN=1
            GLFW_INCLUDE_VULKAN=1
            GLM_FORCE_DEPTH_ZERO_TO_ONE=1)
    # Definitions come from a local wx install when there is one; otherwise the
    # headers shipped in the SDK plus the macOS defaults.
    find_package(wxWidgets QUIET COMPONENTS core base aui propgrid adv richtext
            stc)
    if (wxWidgets_FOUND)
        target_compile_definitions(${TARGET} PRIVATE ${wxWidgets_DEFINITIONS})
    elseif (APPLE)
        target_compile_definitions(${TARGET} PRIVATE
                WXUSINGDLL __WXMAC__ __WXOSX_COCOA__ __WXOSX__
                wxDEBUG_LEVEL=0)
    endif ()
    if (APPLE)
        target_link_options(${TARGET} PRIVATE "-Wl,-undefined,dynamic_lookup")
    endif ()
    set_target_properties(${TARGET} PROPERTIES
            PREFIX ""
            LIBRARY_OUTPUT_DIRECTORY "${SYSTEM_PROJECT}/.mercury/systems"
            RUNTIME_OUTPUT_DIRECTORY "${SYSTEM_PROJECT}/.mercury/systems"
            CXX_SCAN_FOR_MODULES OFF)
    foreach (CONFIG Debug Release RelWithDebInfo MinSizeRel)
        string(TOUPPER "${CONFIG}" CONFIG_UPPER)
        set_target_properties(${TARGET} PROPERTIES
                "LIBRARY_OUTPUT_DIRECTORY_${CONFIG_UPPER}"
                "${SYSTEM_PROJECT}/.mercury/systems"
                "RUNTIME_OUTPUT_DIRECTORY_${CONFIG_UPPER}"
                "${SYSTEM_PROJECT}/.mercury/systems")
    endforeach ()
endfunction()
