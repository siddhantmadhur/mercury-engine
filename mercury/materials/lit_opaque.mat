// Mercury's lit PBR surface: sRGB base color texture x material color x
// vertex color, with per-instance UV tiling/offset, Unity-style metallic
// and smoothness (as roughness), and linear emission. Shared by every lit
// combination; the .mat file only varies in blending/culling.

material {
    name: MercuryLitOpaque,
    shadingModel: lit,
    blending: opaque,
    culling: back,
    requires: [
        position,
        tangents,
        uv0,
        color
    ],
    parameters: [
        { type: float4, name: baseColor },
        { type: sampler2d, name: baseColorMap, precision: high },
        { type: float2, name: tiling },
        { type: float2, name: offset },
        { type: float, name: metallic },
        { type: float, name: roughness },
        { type: float4, name: emissive }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0() * materialParams.tiling + materialParams.offset;
        material.baseColor = materialParams.baseColor * getColor() *
                             texture(materialParams_baseColorMap, uv);
        material.roughness = materialParams.roughness;
        material.metallic = materialParams.metallic;
        material.emissive = materialParams.emissive;
    }
}
