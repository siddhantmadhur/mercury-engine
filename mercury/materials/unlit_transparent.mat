// Transparent unlit textured surface for sprites and alpha-blended 2D quads.

material {
    name: MercuryUnlitTransparent,
    shadingModel: unlit,
    blending: transparent,
    culling: none,
    flipUV: false,
    requires: [
        position,
        uv0
    ],
    parameters: [
        { type: float4, name: baseColor },
        { type: sampler2d, name: baseColorMap, precision: high },
        { type: float2, name: tiling },
        { type: float2, name: offset },
        { type: float4, name: emissive },
        { type: sampler2d, name: emissiveMap, precision: high }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0() * materialParams.tiling + materialParams.offset;
        vec4 color = materialParams.baseColor *
                     texture(materialParams_baseColorMap, uv);
        material.baseColor = vec4(color.rgb * color.a, color.a);
        material.emissive = vec4(
            materialParams.emissive.rgb *
                texture(materialParams_emissiveMap, uv).rgb,
            materialParams.emissive.a);
    }
}
