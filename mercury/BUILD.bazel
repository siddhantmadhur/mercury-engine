load("@mercury_config//:defs.bzl", "COPTS")
load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//mercury/rust:defs.bzl", "mercury_rust_feature")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "core_headers",
    hdrs = [
        "debugger/debugger.h",
        "os/filesystem.h",
        "pack/mpack.h",
    ],
    includes = ["."],
)

mercury_rust_feature(
    name = "os_filesystem_rs",
    src = "os/filesystem.rs",
    cc_deps = [":core_headers"],
)

rust_static_library(
    name = "mercury_rust",
    srcs = ["rust_modules.rs"],
    crate_root = "rust_modules.rs",
    edition = "2024",
    deps = [
        ":os_filesystem_rs",
        "//mercury/rust:mercury_kernel",
    ],
)

cc_library(
    name = "mercury",
    srcs = glob(
        ["**/*.cc"],
        exclude = ["player/main.cc"],
    ) + ["scripting/as/api_prelude.inc"],
    hdrs = glob(["**/*.h"]),
    copts = COPTS + select({
        "@platforms//os:macos": ["-Wno-deprecated-declarations"],
        "//conditions:default": [],
    }),
    data = ["//mercury/shaders:shaders"],
    includes = ["."],
    linkopts = select({
        "@platforms//os:macos": ["-framework CoreFoundation"],
        "//conditions:default": [],
    }),
    deps = [
        ":mercury_rust",
        ":os_filesystem_rs_bridge",
        "//mercury/rust:bridge",
        "@vulkan//:vulkan",
        "//third_party:assimp",
        "//third_party:angelscript",
        "//third_party:entt",
        "//third_party:glfw",
        "//third_party:glm",
        "//third_party:jolt",
        "//third_party:meshoptimizer",
        "//third_party:miniaudio",
        "//third_party:nanosvg",
        "//third_party:stb",
        "//third_party:tinyxml2",
        "//third_party:vulkan_memory_allocator",
        "//third_party:yoga",
    ],
)

cc_binary(
    name = "mercury_player",
    srcs = ["player/main.cc"],
    data = ["//mercury/shaders:shaders"],
    deps = [":mercury"],
)
