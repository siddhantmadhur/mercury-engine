load("@mercury_config//:defs.bzl", "COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mercury",
    srcs = glob(
        ["**/*.cc"],
        exclude = ["player/main.cc"],
    ) + ["scripting/as/api_prelude.inc"],
    hdrs = glob(["**/*.h"]),
    copts = COPTS + select({
        "@platforms//os:macos": ["-Wno-deprecated-declarations"],
        "//conditions:default": [],
    }),
    data = ["//mercury/shaders:shaders"],
    includes = ["."],
    linkopts = select({
        "@platforms//os:macos": ["-framework CoreFoundation"],
        "//conditions:default": [],
    }),
    deps = [
        "@vulkan//:vulkan",
        "//third_party:assimp",
        "//third_party:angelscript",
        "//third_party:entt",
        "//third_party:glfw",
        "//third_party:glm",
        "//third_party:jolt",
        "//third_party:meshoptimizer",
        "//third_party:miniaudio",
        "//third_party:nanosvg",
        "//third_party:stb",
        "//third_party:tinyxml2",
        "//third_party:vulkan_memory_allocator",
        "//third_party:yoga",
    ],
)

cc_binary(
    name = "mercury_player",
    srcs = ["player/main.cc"],
    data = ["//mercury/shaders:shaders"],
    deps = [":mercury"],
)
