load("@mercury_config//:defs.bzl", "COPTS")
load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//mercury/rust:defs.bzl", "mercury_rust_feature")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "core_headers",
    hdrs = [
        "debugger/debugger.h",
        "os/filesystem.h",
        "pack/mpack.h",
    ],
    includes = ["."],
)

cc_library(
    name = "input_headers",
    hdrs = [
        "input/input_actions.h",
    ],
    includes = ["."],
    deps = ["//third_party:glm"],
)

mercury_rust_feature(
    name = "input_actions_codegen_rs",
    src = "input/input_actions_codegen.rs",
    cc_deps = [":input_headers"],
)

rust_static_library(
    name = "mercury_rust",
    srcs = ["rust_modules.rs"],
    crate_root = "rust_modules.rs",
    edition = "2024",
    deps = [
        ":input_actions_codegen_rs",
        "//mercury/rust:mercury_kernel",
    ],
)

cc_library(
    name = "mercury",
    srcs = glob(
        ["**/*.cc"],
        exclude = ["player/main.cc"],
    ) + ["scripting/as/api_prelude.inc"],
    hdrs = glob(["**/*.h"]),
    copts = COPTS + select({
        "@platforms//os:macos": ["-Wno-deprecated-declarations"],
        "//conditions:default": [],
    }),
    data = ["//mercury/materials:materials"],
    includes = ["."],
    linkopts = select({
        # metal_layer_darwin.cc: the CAMetalLayer Filament's Vulkan backend
        # needs, through the Objective-C runtime.
        "@platforms//os:macos": [
            "-framework AppKit",
            "-framework CoreFoundation",
            "-framework Metal",
            "-framework QuartzCore",
            "-lobjc",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":input_actions_codegen_rs_bridge",
        ":mercury_rust",
        "//mercury/rust:bridge",
        "//third_party:assimp",
        "//third_party:angelscript",
        "//third_party:entt",
        "//third_party:filament",
        "//third_party:glfw",
        "//third_party:glm",
        "//third_party:jolt",
        "//third_party:meshoptimizer",
        "//third_party:miniaudio",
        "//third_party:nanosvg",
        "//third_party:stb",
        "//third_party:tinyxml2",
        "//third_party:yoga",
        "@vulkan//:vulkan",
    ],
)

cc_binary(
    name = "mercury_player",
    srcs = ["player/main.cc"],
    data = ["//mercury/materials:materials"],
    deps = [":mercury"],
)
