/*
 * Mercury's default runtime theme, modeled on Unity's "Unity Default
 * Runtime Theme". Panels use it unless their PanelSettings name another
 * theme_style_sheet. Override any of these in your own sheets.
 */

:root {
    --unity-colors-default-text: #090909;
    --unity-colors-button-background: #E4E4E4;
    --unity-colors-button-background-hover: #ECECEC;
    --unity-colors-button-background-pressed: #B1B1B1;
    --unity-colors-button-border: #B2B2B2;
    --unity-colors-button-text: #090909;
    --unity-colors-input_field-background: #F0F0F0;
    --unity-colors-input_field-border: #A8A8A8;
    --unity-colors-input_field-border-focus: #3A72B0;
    --unity-colors-input_field-border-hover: #808080;
    --unity-colors-highlight-background: #3A72B0;
    --unity-colors-slider_groove-background: #8F8F8F;
    --unity-colors-slider_thumb-background: #F4F4F4;
    --unity-colors-slider_thumb-border: #999999;
    --unity-colors-scrollbar_groove-background: #DFDFDF;
    --unity-colors-scrollbar_thumb-background: #A4A4A4;
    --unity-colors-scrollbar_thumb-background-hover: #8C8C8C;
    --unity-colors-focus: #3A79BB;

    color: var(--unity-colors-default-text);
    font-size: 12px;
}

/* ----------------------------------------------------------------- Text */

.unity-label {
    padding: 2px;
    margin: 1px 3px;
    -unity-text-align: middle-left;
}

/* -------------------------------------------------------------- Buttons */

.unity-button, .unity-repeat-button {
    background-color: var(--unity-colors-button-background);
    border-width: 1px;
    border-color: var(--unity-colors-button-border);
    border-radius: 3px;
    padding: 1px 6px;
    margin: 1px 3px;
    min-height: 20px;
    color: var(--unity-colors-button-text);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition: background-color 0.1s ease-out;
}

.unity-button:hover, .unity-repeat-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.unity-button:active, .unity-repeat-button:active {
    background-color: var(--unity-colors-button-background-pressed);
}

.unity-button:focus, .unity-repeat-button:focus {
    border-color: var(--unity-colors-focus);
}

.unity-button:disabled, .unity-repeat-button:disabled {
    opacity: 0.5;
}

/* --------------------------------------------------------------- Fields */

.unity-base-field {
    flex-direction: row;
    margin: 1px 3px;
    min-height: 20px;
    align-items: center;
}

.unity-base-field:disabled {
    opacity: 0.5;
}

.unity-base-field__label {
    min-width: 120px;
    padding: 2px;
    margin: 0 4px 0 0;
    -unity-text-align: middle-left;
}

.unity-base-field__input {
    flex-grow: 1;
}

/* --------------------------------------------------------------- Toggle */

.unity-toggle__input {
    flex-direction: row;
    flex-grow: 0;
    align-items: center;
}

.unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    background-color: var(--unity-colors-input_field-background);
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border);
    border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.unity-toggle:hover .unity-toggle__checkmark {
    border-color: var(--unity-colors-input_field-border-hover);
}

.unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--unity-colors-input_field-border-focus);
}

.unity-toggle__checkmark:checked {
    background-color: var(--unity-colors-highlight-background);
    border-color: var(--unity-colors-highlight-background);
    background-image: url("mercury://icons/check.png");
}

.unity-toggle__text {
    margin: 0 0 0 4px;
    padding: 0;
}

.unity-radio-button__checkmark-background {
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.unity-radio-button__checkmark {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

.unity-radio-button__checkmark-background:checked {
    background-color: var(--unity-colors-input_field-background);
    border-color: var(--unity-colors-highlight-background);
    background-image: none;
}

.unity-radio-button__checkmark-background:checked > .unity-radio-button__checkmark {
    background-color: var(--unity-colors-highlight-background);
}

/* -------------------------------------------------------------- Sliders */

.unity-base-slider__input {
    min-height: 18px;
}

.unity-base-slider__drag-container {
    flex-grow: 1;
    min-height: 18px;
    margin: 0 7px;
}

.unity-base-slider--horizontal .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 4px;
    translate: 0 -50%;
    border-radius: 2px;
    background-color: var(--unity-colors-slider_groove-background);
}

.unity-base-slider--horizontal .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    translate: -50% -50%;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-slider_thumb-border);
    background-color: var(--unity-colors-slider_thumb-background);
}

.unity-base-slider--vertical .unity-base-slider__drag-container {
    margin: 7px 0;
    min-height: 60px;
}

.unity-base-slider--vertical .unity-base-slider__tracker {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    translate: -50% 0;
    border-radius: 2px;
    background-color: var(--unity-colors-slider_groove-background);
}

.unity-base-slider--vertical .unity-base-slider__dragger {
    position: absolute;
    left: 50%;
    width: 12px;
    height: 12px;
    translate: -50% -50%;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-slider_thumb-border);
    background-color: var(--unity-colors-slider_thumb-background);
}

.unity-base-slider:focus .unity-base-slider__dragger {
    border-color: var(--unity-colors-focus);
}

/* --------------------------------------------------------- Progress bar */

.unity-progress-bar {
    margin: 1px 3px;
}

.unity-progress-bar__container {
    flex-grow: 1;
    min-height: 16px;
}

.unity-progress-bar__background {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--unity-colors-input_field-background);
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border);
    border-radius: 2px;
    overflow: hidden;
}

.unity-progress-bar__progress {
    background-color: var(--unity-colors-highlight-background);
    height: 100%;
}

.unity-progress-bar__title-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.unity-progress-bar__title {
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* ---------------------------------------------------------- Text fields */

.unity-base-text-field__input {
    background-color: var(--unity-colors-input_field-background);
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border);
    border-radius: 3px;
    padding: 1px 3px;
    overflow: hidden;
    justify-content: center;
    min-height: 18px;
    --unity-cursor-color: #000000;
    --unity-selection-color: rgba(61, 128, 223, 0.65);
}

.unity-base-text-field:hover .unity-base-text-field__input {
    border-color: var(--unity-colors-input_field-border-hover);
}

.unity-base-text-field:focus .unity-base-text-field__input {
    border-color: var(--unity-colors-input_field-border-focus);
}

.unity-text-element--inner-input-field-component {
    white-space: nowrap;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.unity-text-field--multiline .unity-text-element--inner-input-field-component {
    white-space: pre-wrap;
    -unity-text-align: upper-left;
}

.unity-text-field--multiline .unity-base-text-field__input {
    justify-content: flex-start;
}

/* ----------------------------------------------------------- Scrolling */

.unity-scroll-view {
    flex-grow: 1;
    overflow: hidden;
}

.unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-scroll-view__content-container {
    position: absolute;
    left: 0;
    top: 0;
}

/* Vertical content lays out in the viewport, so a scroll view without a
   set height grows to fit its items, as in Unity. */
.unity-scroll-view--vertical .unity-scroll-view__content-container {
    position: relative;
    right: 0;
    flex-shrink: 0;
}

.unity-scroll-view--horizontal .unity-scroll-view__content-container {
    bottom: 0;
    flex-direction: row;
}

.unity-scroller {
    background-color: var(--unity-colors-scrollbar_groove-background);
}

.unity-scroller--vertical {
    width: 12px;
}

.unity-scroller--horizontal {
    height: 12px;
    flex-direction: row;
}

.unity-scroller__slider {
    flex-grow: 1;
    margin: 2px;
}

.unity-scroller__dragger {
    position: absolute;
    background-color: var(--unity-colors-scrollbar_thumb-background);
    border-radius: 4px;
}

.unity-scroller--vertical .unity-scroller__dragger {
    left: 0;
    right: 0;
}

.unity-scroller--horizontal .unity-scroller__dragger {
    top: 0;
    bottom: 0;
}

.unity-scroller__dragger:hover {
    background-color: var(--unity-colors-scrollbar_thumb-background-hover);
}

/* ------------------------------------------------------------ Foldouts */

.unity-foldout__toggle .unity-toggle__checkmark {
    width: 12px;
    height: 12px;
    border-width: 0;
    background-color: transparent;
    background-image: url("mercury://icons/arrow-right.png");
    -unity-background-image-tint-color: #505050;
}

.unity-foldout__toggle .unity-toggle__checkmark:checked {
    background-color: transparent;
    background-image: url("mercury://icons/arrow-down.png");
}

.unity-foldout__content {
    margin-left: 15px;
}

/* ------------------------------------------------------- Lists & boxes */

.unity-list-view {
    flex-grow: 1;
    background-color: var(--unity-colors-input_field-background);
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border);
}

.unity-list-view__item {
    padding: 0 6px;
    justify-content: center;
}

.unity-list-view__item:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

.unity-collection-view__item--selected {
    background-color: var(--unity-colors-highlight-background);
    color: #FFFFFF;
}

.unity-collection-view__item--selected:hover {
    background-color: var(--unity-colors-highlight-background);
}

.unity-box {
    background-color: rgba(0, 0, 0, 0.05);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.2);
}

.unity-group-box {
    margin: 3px;
    padding: 3px;
}

.unity-group-box__label {
    -unity-font-style: bold;
}
