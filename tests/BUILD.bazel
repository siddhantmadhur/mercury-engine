load("@mercury_config//:defs.bzl", "COPTS")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "mercury_test",
    srcs = [
        "gameplay_test.cc",
        "hierarchy_test.cc",
        "input_actions_test.cc",
        "map_test.cc",
        "model_cache_test.cc",
        "model_preloader_test.cc",
        "mpack_test.cc",
        "mtext_test.cc",
        "parallel_load_test.cc",
        "physics_constraints_test.cc",
        "primitives_test.cc",
        "reflection_test.cc",
        "script_behaviour_test.cc",
        "script_runtime_test.cc",
        "test_paths.h",
